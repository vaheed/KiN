# KiN v0.1.0 environment configuration
# Copy this file to .env before running: cp .env.example .env
#
# Development defaults are intentionally local-only. Replace every value marked
# SECRET before sharing the host or exposing any service through a reverse proxy.
# Generate secrets with:
#   openssl rand -hex 32

# -----------------------------------------------------------------------------
# Compose / host ports
# -----------------------------------------------------------------------------
# Bind published application ports to loopback by default.
HOST_BIND_IP=127.0.0.1
KiN_HOST_PORT=8000
TRUEFORGE_HOST_BIND_IP=127.0.0.1
TRUEFORGE_HOST_PORT=8790
BIFROST_HOST_PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL superuser (used only by the init script)
# -----------------------------------------------------------------------------
# The init script creates separate KiN and TrueForge databases/users from these
# values. This superuser is not used by the application containers after init.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-superuser-secret

# -----------------------------------------------------------------------------
# KiN PostgreSQL credentials
# -----------------------------------------------------------------------------
# Database name and user are created by infra/postgres/init/01-init.sh.
KiN_DB_NAME=kin
KiN_DB_USER=kin
KiN_DB_PASSWORD=change-this-kin-database-secret
KiN_DB_HOST=postgres
KiN_DB_PORT=5432

# PostgreSQL connection pool. Increase only after measuring connection pressure.
KiN_DB_POOL_MIN=1
KiN_DB_POOL_MAX=8

# -----------------------------------------------------------------------------
# TrueForge PostgreSQL credentials
# -----------------------------------------------------------------------------
# TrueForge runs in hosted mode, so it uses this database plus the shared Redis.
TRUEFORGE_DB_NAME=trueforge
TRUEFORGE_DB_USER=trueforge
TRUEFORGE_DB_PASSWORD=change-this-trueforge-database-secret

# -----------------------------------------------------------------------------
# Redis / working memory
# -----------------------------------------------------------------------------
# KiN and TrueForge use logical separation by key prefix; TrueForge itself also
# stores execution peering/state here. Redis is never published to the host.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# KiN HTTP/application behavior
# -----------------------------------------------------------------------------
KiN_ENV=production
KiN_LOG_LEVEL=INFO
KiN_WORKING_MEMORY_TTL_SECONDS=86400
KiN_SESSION_MAX_CONTEXT_ITEMS=30

# The profile adjusts thresholds; the actual execution mode is derived from each decision.
KiN_AUTONOMY_PROFILE=balanced

# -----------------------------------------------------------------------------
# Bifrost / Decision Maker
# -----------------------------------------------------------------------------
# Bifrost is the only model gateway KiN calls directly.
BIFROST_URL=http://bifrost:8080
BIFROST_API_KEY=

# Decision Maker model lanes. All model traffic goes through Bifrost -> OpenRouter.
KiN_DECISION_MODEL=anthropic/claude-sonnet-5.5
KiN_DECISION_MODEL_FAST=google/gemini-3.8-flash
KiN_DECISION_MODEL_DEEP=anthropic/claude-opus-5.5

# Optional JEV decision gate. Disabled by default because JEV is a Decisions API
# model rather than a normal chat-completions model.
KiN_DECISION_GATE_ENABLED=false
KiN_DECISION_GATE_MODEL=typesafe/jev-1.13

# Mem0 OSS durable memory.
# The Mem0 LLM and embedder point to Bifrost's OpenAI-compatible /v1 endpoint.
KiN_MEMORY_LLM_MODEL=google/gemini-3.8-flash
KiN_MEMORY_USER_ID=owner
KiN_MEMORY_AGENT_ID=kin
KiN_MEMORY_COLLECTION=kin_memories
KiN_MEMORY_HISTORY_DB_PATH=/app/data/mem0/history.db
KiN_MEMORY_SEARCH_LIMIT=8
KiN_MEMORY_MIN_SIMILARITY=0.15

# Embedding model and vector width. Mem0 stores the resulting vectors in pgvector.
KiN_EMBEDDING_MODEL=openai/text-embedding-3-small
KiN_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# OpenRouter credentials for Bifrost
# -----------------------------------------------------------------------------
# OpenRouter is behind Bifrost. Put the OpenRouter key here; Bifrost consumes
# it through env.OPENROUTER_API_KEY. No provider credential belongs in Git.
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Bifrost secrets and host behavior
# -----------------------------------------------------------------------------
# Bifrost file-only config uses this key to encrypt internal sensitive state.
# This example is 32 bytes represented as 64 hexadecimal characters. Generate a fresh one with:
#   openssl rand -hex 32
BIFROST_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# TrueForge service
# -----------------------------------------------------------------------------
TRUEFORGE_API_KEY=replace-with-a-strong-trueforge-api-key
TRUEFORGE_PUBLIC_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=
TRUEFORGE_AGENT_NAME=
TRUEFORGE_MODEL=anthropic/claude-sonnet-5.5
TRUEFORGE_EXECUTION_TIMEOUT_SECONDS=600

# TrueForge v0.3.x blocks private/cluster destinations by default. Because this
# Compose stack intentionally routes its optional model provider through the
# internal Bifrost service, allow the Compose DNS name explicitly.
TRUEFORGE_NETWORK_POLICY_ENABLED=true
TRUEFORGE_OUTBOUND_URL_ALLOWED_HOSTS=["bifrost"]

# -----------------------------------------------------------------------------
# Optional integration behavior
# -----------------------------------------------------------------------------
# TRUEFORGE integration is available through POST /v1/trueforge/run. Set an
# agent name to use a saved TrueForge agent. With no name, KiN sends an inline
# model spec using TRUEFORGE_MODEL.
KiN_TRUEFORGE_ENABLED=true
